# ────────────────────────────────────────────────────────────────
# GoogleQuery 환경변수 템플릿
# 실제 사용: cp .env.example .env  → 값 채우기
# .env는 gitignore에 포함됨
# ────────────────────────────────────────────────────────────────

# GCP 프로젝트 ID (Drive 서비스 계정이 있는 프로젝트)
GCP_PROJECT_ID=price-lens

# Drive 루트 폴더 ID (현재는 검색 시 사용하지 않지만 추후 필터링용)
DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID

# ────────────────────────────────────────────────────────────────
# 로컬 개발용 (npm run dev 시에만 필요)
# - credentials.json을 쓰려면 아래 한 줄 추가:
#     GOOGLE_APPLICATION_CREDENTIALS=./credentials.json
# - 또는 gcloud auth application-default login 으로 ADC 설정
# Cloud Run에서는 자동으로 인스턴스 서비스 계정이 쓰이므로 불필요.
# ────────────────────────────────────────────────────────────────
